# Writes OUT (C++): the commit this build was made from and whether the tree had
# uncommitted tracked changes, so every result row names its own build (perf DB
# runs.build_sha / build_dirty). Runs on every build (target aegis_build_info);
# OUT is rewritten only when the identity changes, so nothing else recompiles.
#   cmake -DSRC=<source dir> -DOUT=<file> -P cmake/build_info.cmake
find_package(Git QUIET)
set(sha "")
set(dirty "true")
set(known "false")
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC} rev-parse HEAD
                  OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc1)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC} status --porcelain --untracked-files=no
                  OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc2)
  if(rc1 EQUAL 0 AND rc2 EQUAL 0 AND sha MATCHES "^[0-9a-f]+$")
    set(known "true")
    if(changes STREQUAL "")
      set(dirty "false")
    endif()
  else()
    set(sha "")
  endif()
endif()
set(body "// Generated by cmake/build_info.cmake. Do not edit.\n#include \"bench/build_info.h\"\nnamespace aegis::bench {\nconst BuildInfo kBuild = {\"${sha}\", ${dirty}, ${known}};\n}  // namespace aegis::bench\n")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL body)
  file(WRITE ${OUT} "${body}")
endif()
