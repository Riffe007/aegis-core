#!/usr/bin/env bash
# AEGIS pre-commit: the build must be current and ctest must pass.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# No Python in AEGIS Core (CLAUDE.md rule 9): refuse any *.py, staged or tracked.
py="$( { git diff --cached --name-only --diff-filter=ACR; git ls-files; } | grep -E '\.py$' | sort -u || true)"
if [[ -n "$py" ]]; then
  echo "pre-commit: Python files are not allowed in AEGIS Core:" >&2
  echo "$py" | sed 's/^/  /' >&2
  exit 1
fi

# No staged file over 5 MB (build output in e799a4f had to be stripped from history).
big=""
while IFS= read -r -d '' f; do
  size="$(git cat-file -s ":$f")"
  if (( size > 5 * 1024 * 1024 )); then big+="  $f ($size bytes)"$'\n'; fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [[ -n "$big" ]]; then
  echo "pre-commit: staged files over 5 MB are not allowed:" >&2
  printf '%s' "$big" >&2
  exit 1
fi

if [[ ! -d build ]]; then
  echo "pre-commit: no build/ directory; run cmake -S . -B build -DCMAKE_BUILD_TYPE=Release" >&2
  exit 1
fi
# The sm_87 compile gate (CMake option AEGIS_SM87_GATE, ctest sm87_gate) is
# part of every commit; switch it on in build/ if it is not.
if ! grep -q "^AEGIS_SM87_GATE:BOOL=ON" build/CMakeCache.txt 2>/dev/null; then
  echo "pre-commit: enabling the sm_87 compile gate in build/" >&2
  cmake -S . -B build -DAEGIS_SM87_GATE=ON >/dev/null
fi
echo "pre-commit: building and running ctest (incl. sm87_gate)..." >&2
if ! cmake --build build -j >/tmp/aegis-precommit-build.log 2>&1; then
  grep -E "error|Error" /tmp/aegis-precommit-build.log | head -20 >&2
  echo "pre-commit: build failed; commit refused (full log: /tmp/aegis-precommit-build.log)" >&2
  exit 1
fi
if ! ctest --test-dir build --output-on-failure -j4 >/tmp/aegis-precommit-ctest.log 2>&1; then
  tail -40 /tmp/aegis-precommit-ctest.log >&2
  echo "pre-commit: ctest failed; commit refused (full log: /tmp/aegis-precommit-ctest.log)" >&2
  exit 1
fi
grep -E "tests passed" /tmp/aegis-precommit-ctest.log >&2
