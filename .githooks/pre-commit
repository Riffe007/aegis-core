#!/usr/bin/env bash
# AEGIS pre-commit: the build must be current and ctest must pass.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# No Python in AEGIS Core (CLAUDE.md rule 9): refuse any *.py, staged or tracked.
py="$( { git diff --cached --name-only --diff-filter=ACR; git ls-files; } | grep -E '\.py$' | sort -u || true)"
if [[ -n "$py" ]]; then
  echo "pre-commit: Python files are not allowed in AEGIS Core:" >&2
  echo "$py" | sed 's/^/  /' >&2
  exit 1
fi

if [[ ! -d build ]]; then
  echo "pre-commit: no build/ directory; run cmake -S . -B build -DCMAKE_BUILD_TYPE=Release" >&2
  exit 1
fi
echo "pre-commit: building and running ctest..." >&2
cmake --build build -j >/dev/null
if ! ctest --test-dir build --output-on-failure -j4 >/tmp/aegis-precommit-ctest.log 2>&1; then
  tail -40 /tmp/aegis-precommit-ctest.log >&2
  echo "pre-commit: ctest failed; commit refused (full log: /tmp/aegis-precommit-ctest.log)" >&2
  exit 1
fi
grep -E "tests passed" /tmp/aegis-precommit-ctest.log >&2
