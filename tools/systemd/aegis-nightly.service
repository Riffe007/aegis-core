# AEGIS Core nightly job (tools/nightly.sh). Installed by tools/nightly.sh --install
# into ~/.config/systemd/user/.
[Unit]
Description=AEGIS Core nightly: 50k fuzz, regression sweep, perf DB backup

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/projects/aegis
ExecStart=%h/Documents/projects/aegis/tools/nightly.sh
TimeoutStartSec=4h
